# React frontend — build with Node, serve the static bundle with nginx,
# which proxies /api to the api-gateway service. Build context must be the
# repository root.
FROM node:20-alpine AS build
WORKDIR /app
COPY translator-frontend/package*.json ./
RUN npm ci
COPY translator-frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
