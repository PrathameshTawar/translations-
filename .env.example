# Copy to .env and fill in. docker compose reads this file automatically.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Optional: enables grounded QA (/api/v1/qa/ask) and the LLM post-edit
# terminology strategy.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Protects POST /api/v1/evaluate/run (send as the "X-Admin-Token" header).
# When empty, the endpoint is disabled (403).
EVAL_ADMIN_TOKEN=
