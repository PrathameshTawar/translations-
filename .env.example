# Copy to .env and fill in. docker compose reads this file automatically.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Optional: enables grounded QA (/api/v1/qa/ask).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Operator endpoints (POST /api/v1/evaluate/run, /api/v1/tm/*) require this
# value in the "X-Admin-Token" header. Empty = those endpoints are disabled.
ADMIN_TOKEN=

# Optional: share rate-limit counters across gunicorn workers.
# RATELIMIT_STORAGE_URI=redis://redis:6379/0
